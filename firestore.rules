rules_version = '2';
// AfyaTrack PHO: all reads and writes go through the AfyaTrack API (Firebase Admin SDK on the server),
// which enforces roles and ward scoping. Direct client access to Firestore is denied.
// Deny every direct read and write. Only the API server (Admin SDK) can use the database.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
